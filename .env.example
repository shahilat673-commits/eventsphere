# Copy to .env and edit. Everything works in DEMO mode with no keys.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DEMO_MODE=True

# Database: sqlite (default) | mysql | postgres
DB_ENGINE=sqlite
DB_NAME=eventsphere
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=

# AI engine (set ONE; if none is set, built-in offline AI fallback is used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Razorpay (leave blank for demo payment page)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email - REAL OTP mails (Gmail example). Create an App Password at https://myaccount.google.com/apppasswords
# Leave EMAIL_HOST blank to stay in demo mode (OTP shown on screen).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# SMS via Twilio (blank = SMS saved in Notification Log / terminal)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
